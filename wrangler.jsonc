{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rag-ai-agentic",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    "JWT_SECRET": "dev-secret-change-in-production"
  },
  "kv_namespaces": [
    {
      "binding": "KV_CACHE",
      "id": "f6f690bde1754176a30843cb6542a1f4"
    }
  ],
  "r2_buckets": [],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiterDO"
      },
      {
        "name": "PROVIDER_RATE_LIMITER",
        "class_name": "ProviderRateLimiterDO"
      }
    ]
  },
  "exports": {
    "RateLimiterDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ProviderRateLimiterDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
